{
  "name": "power-blade-2-coop-netcode",
  "version": "1.0.0",
  "description": "Browser Dual-Emulator Memory & Sprite Sync Co-op for Power Blade 2 (NES) over WebSocket/TLS (wss://)",
  "type": "module",
  "main": "server/relay_server.mjs",
  "scripts": {
    "start": "node server/relay_server.mjs",
    "autotest": "powershell -ExecutionPolicy Bypass -File ./start_online.ps1 -Mode autotest",
    "online": "powershell -ExecutionPolicy Bypass -File ./start_online.ps1 -Mode game",
    "online:pinggy": "powershell -ExecutionPolicy Bypass -File ./start_online.ps1 -Tunnel pinggy -Mode autotest",
    "test": "node tools/test_coop_qa.mjs",
    "test:net": "node tools/test_net_diagnostics.mjs",
    "test:roms": "node tools/test_real_roms.mjs",
    "probe": "node tools/re_probe.mjs"
  },
  "dependencies": {
    "jsnes": "^2.1.0",
    "ws": "^8.18.0"
  },
  "license": "MIT"
}
